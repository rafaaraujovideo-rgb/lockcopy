# Copiar para .env e preencher com os valores do teu projeto Supabase.
# A chave publicável é pública por desenho; nunca ponhas a chave secreta aqui.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Só para o servidor (trabalhadores e rotas api). Não usar no browser.
SUPABASE_SERVICE_ROLE_KEY=

# Emails transacionais (lembretes e avisos) via Brevo
# Chave em Brevo → SMTP & API → API Keys; o remetente (EMAIL_FROM) tem de usar
# um domínio/remetente verificado no Brevo.
BREVO_API_KEY=
EMAIL_FROM=Lockcopy <notificacoes@lockcopy.com>

# Segredo partilhado para o cron externo chamar /api/public/cron/notifications
CRON_SECRET=

# Cobrança (Stripe). O teste de 14 dias só começa quando o Stripe confirma o cartão.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SOLO_YEAR=
STRIPE_PRICE_AGENCY_YEAR=
APP_URL=https://lockcopy.com

# Copiar para .env e preencher com os valores do teu projeto Supabase.
# A chave publicável é pública por desenho; nunca ponhas a chave secreta aqui.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Só para o servidor (trabalhadores e rotas api). Não usar no browser.
SUPABASE_SERVICE_ROLE_KEY=
